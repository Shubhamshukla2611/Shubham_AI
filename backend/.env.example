# ──────────────────────────────────────────────
# Groq API (LLM only — embeddings are local)
# ──────────────────────────────────────────────
# Get a free API key at: https://console.groq.com/keys
# Optional at startup — the server boots without it, but AI endpoints
# (chat, generation) will return a clear error until you set this.
GROQ_API_KEY=your_groq_api_key_here

# ──────────────────────────────────────────────
# Model Configuration
# ──────────────────────────────────────────────
# Default: llama-3.1-8b-instant (fast, low-latency model)
GROQ_MODEL=llama-3.1-8b-instant

# Embeddings are local via sentence-transformers — no API key needed.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ──────────────────────────────────────────────
# RAG Configuration
# ──────────────────────────────────────────────
# Number of chunks to retrieve per query
RETRIEVAL_TOP_K=3

# Chunking parameters (in characters, ~4 chars per token)
CHUNK_SIZE=1500
CHUNK_OVERLAP=300

# Minimum cosine similarity score to include a chunk (range 0.0–1.0).
# MiniLM scores for relevant text typically land in 0.20–0.55 on a small
# personal KB (8–15 chunks); the absolute number is lower than what
# larger Gemini embeddings produced. 0.22 is the calibrated default —
# raise to 0.3+ for stricter grounding, or lower to 0.15 if generic
# meta-queries ("tell me about your projects") are refusing.
MIN_SCORE=0.22

# Public Google Calendar booking URL.
# Leave blank to disable booking CTAs.
GOOGLE_CALENDAR_URL=https://calendar.app.google/GQ3M1pXChb47p69b8

# Backward-compatible alias for earlier generic booking support.
CALENDAR_BOOKING_URL=

# Google Meet link used in the invite generated after booking.
GOOGLE_MEET_URL=https://meet.google.com/new

# Optional interviewer/host email copied into booking responses.
INTERVIEWER_EMAIL=

# Owner email for calendar invites (receives booking confirmations)
OWNER_EMAIL=shubhamshu382@gmail.com

# ──────────────────────────────────────────────
# Voice Agent (Vapi + Google Calendar Integration)
# ──────────────────────────────────────────────
# Get Vapi API key at: https://dashboard.vapi.ai/account
VAPI_API_KEY=your_vapi_api_key_here

# Vapi Assistant ID (created in Vapi dashboard after setting up this backend)
VAPI_ASSISTANT_ID=

# Vapi Phone Number ID (assigned when you provision a phone number in Vapi)
VAPI_PHONE_NUMBER_ID=

# Twilio Auth Token (provided by Vapi when setting up Twilio integration)
TWILIO_AUTH_TOKEN=

# Google Calendar Service Account Credentials (JSON format)
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Create a service account and download JSON credentials
# 3. Share your calendar with the service account email
# 4. Paste the entire JSON as a single-line string here
# Example format (all on one line):
# GOOGLE_CALENDAR_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"..."}
GOOGLE_CALENDAR_CREDENTIALS_JSON=

# Webhook secret for validating Vapi requests
VOICE_WEBHOOK_SECRET=dev-secret-change-in-production

# ──────────────────────────────────────────────
# CORS (Frontend Origins)
# ──────────────────────────────────────────────
# Comma-separated list of allowed origins
# Local development: http://localhost:5173
# Production: add your Vercel domain
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176,http://localhost:3000,http://127.0.0.1:3000

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO