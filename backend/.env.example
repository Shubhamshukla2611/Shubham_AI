# ──────────────────────────────────────────────
# Shubham AI — Backend env template
# ──────────────────────────────────────────────
# Copy this file to .env for local dev. On Render, set these in the
# dashboard (Environment section) instead.
# ──────────────────────────────────────────────

# ── LLM (Groq) ─────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Embeddings (local — no key) ────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── RAG ────────────────────────────────────────
RETRIEVAL_TOP_K=3
CHUNK_SIZE=1500
CHUNK_OVERLAP=300
MIN_SCORE=0.18

# ── Calendar / Booking ─────────────────────────
GOOGLE_CALENDAR_URL=https://calendar.app.google/GQ3M1pXChb47p69b8
GOOGLE_MEET_URL=https://meet.google.com/new
OWNER_EMAIL=shubhamshu382@gmail.com
INTERVIEWER_EMAIL=

# ── Voice (Vapi + Twilio) ──────────────────────
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
TWILIO_AUTH_TOKEN=
VOICE_WEBHOOK_SECRET=replace-with-a-long-random-string

# ── Google Calendar service account (full JSON, single line) ─
GOOGLE_CALENDAR_CREDENTIALS_JSON=

# ── CORS ───────────────────────────────────────
# Comma-separated. Include your Vercel frontend on Render.
ALLOWED_ORIGINS=https://shubham-ai-omega.vercel.app,http://localhost:5173,http://localhost:3000

# ── Server ─────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
